<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1900 是「取不到漏洞数据」，不是查出了漏洞（那是 NU1901–NU1904，照样报错）。
         网络抖一下就让镜像构建失败不值得。 -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 发布流程传入正式版本或 0.0.0-edge，以及 SourceRevisionId（ADR-0022）；
         未传版本时默认 0.0.0-dev，免得把 SDK 默认的 1.0.0 当成真版本。 -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

</Project>
